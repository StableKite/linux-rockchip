/* Orange Pi 5 Max: one four-lane IMX415 on Camera2. */
#include "rk3588-orangepi-5-max.dts"

/ {
	model = "Orange Pi 5 Max with IMX415 on Camera2";
};

&i2c7 {
	status = "okay";

	imx415_cam2: imx415@1a {
		compatible = "sony,imx415";
		reg = <0x1a>;
		clocks = <&cru CLK_MIPI_CAMARAOUT_M3>;
		clock-names = "xvclk";
		assigned-clocks = <&cru CLK_MIPI_CAMARAOUT_M3>;
		assigned-clock-rates = <37125000>;
		power-domains = <&power RK3588_PD_VI>;
		pinctrl-names = "default";
		pinctrl-0 = <&mipim1_camera3_clk>;
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
		power-gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
		rockchip,camera-module-index = <2>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "IMX415";
		rockchip,camera-module-lens-name = "default";
		rockchip,camera-hdr-mode = <0>;
		status = "okay";

		port {
			imx415_cam2_out: endpoint {
				remote-endpoint = <&mipidcphy0_in_cam1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&mipidcphy0_in_cam1 {
	remote-endpoint = <&imx415_cam2_out>;
	data-lanes = <1 2 3 4>;
};

&ov13855_out2 {
	/delete-property/ remote-endpoint;
};

&csi2_dcphy0 {
	status = "okay";
};

&mipi0_csi2 {
	status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";
};

&rkcif_mipi_lvds_sditf {
	status = "okay";
};

&rkisp0_vir0 {
	status = "okay";
};
